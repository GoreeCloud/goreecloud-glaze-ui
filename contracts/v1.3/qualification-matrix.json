{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 3,
  "product": "GLAZE UI V1.3",
  "targetVersion": "1.3.0-candidate",
  "lifecycle": "qualification-active",
  "sourceStable": "1.2.0",
  "authority": "acceptance/v1.3-deferred-qualification.md",
  "evidenceSchema": "contracts/v1.3/qualification-evidence.schema.json",
  "qualityContract": "contracts/v1.3/quality-rules.candidate.json",
  "candidateReadiness": "contracts/v1.3/qualification-readiness.candidate.json",
  "stableReadiness": "contracts/v1.3/stable-readiness.plan.json",
  "workstreams": [
    {
      "id": "human-optical-and-icon-collision-qualification",
      "title": "Human optical, visual-finish, and icon-collision qualification",
      "stage": "pre-candidate",
      "status": "planned",
      "mode": "human",
      "blockingForCandidatePromotion": true,
      "blockingForStablePromotion": true,
      "requiredEvidence": ["authorized human or combined review record", "complete review of all 55 rules in contracts/v1.3/quality-rules.candidate.json", "visual finish and blandness-rejection acceptance", "accessibility-as-beauty and responsive-beauty review", "representative Light, Dark, Deep Dark, clarity/expression, reference-scene, icon and artwork collision review"]
    },
    {
      "id": "manual-assistive-technology-qualification",
      "title": "Manual assistive-technology qualification",
      "stage": "pre-candidate",
      "status": "planned",
      "mode": "human-assisted",
      "blockingForCandidatePromotion": true,
      "blockingForStablePromotion": true,
      "requiredEvidence": ["claimed support-matrix declaration", "manual screen-reader, voice-control, switch-control, keyboard and focus-order evidence where claimed", "issues and disposition record"]
    },
    {
      "id": "physical-device-native-platform-qualification",
      "title": "Physical-device and native-platform qualification",
      "stage": "pre-candidate",
      "status": "planned",
      "mode": "mixed",
      "blockingForCandidatePromotion": true,
      "blockingForStablePromotion": true,
      "requiredEvidence": ["device and operating-system inventory", "Android/OEM and Linux compositor/window-system evidence where claimed", "foldable/posture evidence where claimed", "native-platform variance and disposition record"]
    },
    {
      "id": "physical-device-production-performance-qualification",
      "title": "Physical-device production performance qualification",
      "stage": "pre-candidate",
      "status": "planned",
      "mode": "mixed",
      "blockingForCandidatePromotion": true,
      "blockingForStablePromotion": true,
      "requiredEvidence": ["accepted runtime/platform performance budget", "frame-pacing and interaction-latency measurements", "memory, GPU/compositor, power and thermal measurements where applicable", "constrained-device evidence"]
    },
    {
      "id": "native-personalization-adapter-qualification",
      "title": "Native Personalization adapter qualification",
      "stage": "pre-candidate",
      "status": "planned",
      "mode": "mixed",
      "blockingForCandidatePromotion": true,
      "blockingForStablePromotion": true,
      "requiredEvidence": ["persistence evidence where claimed", "system-appearance and wallpaper-source adapter evidence where claimed", "failure and fallback behavior evidence"]
    },
    {
      "id": "stable-activation-and-source-namespace-cleanup",
      "title": "Stable activation and source-namespace cleanup",
      "stage": "post-candidate-pre-stable",
      "status": "planned",
      "mode": "automated-plus-review",
      "blockingForCandidatePromotion": false,
      "blockingForStablePromotion": true,
      "requiredEvidence": ["active Candidate provenance and qualified Candidate source revision", "candidate-name inventory and migration map", "byte/pixel/behavior equivalence evidence for renamed or promoted sources", "import-closure validation", "rollback verification", "exact post-Candidate Stable-promotion source revision"]
    }
  ],
  "globalRules": {
    "v1.2EvidenceMayNotBeReclassifiedAsV1.3Pass": true,
    "exactSourceRevisionRequired": true,
    "allCandidateBlockingWorkstreamsMustPassBeforeCandidatePromotion": true,
    "candidateBlockingWorkstreamsMustPassSameExactRevision": true,
    "allStableBlockingWorkstreamsMustPassBeforeStablePromotion": true,
    "stableCleanupOccursAfterCandidateActivation": true,
    "stableCleanupMayTargetLaterExactRevisionThanCandidateQualification": true,
    "stablePromotionRequiresCandidateQualificationProvenance": true,
    "passedEvidenceAllowedWhileQualificationActive": true,
    "qualificationReadinessDoesNotPromoteLifecycle": true,
    "humanOpticalPassRequiresFullQualityRuleCoverage": true,
    "automatedValidationDoesNotReplaceHumanReview": true,
    "consumerEligibilityIsSeparate": true,
    "downstreamProductionAcceptanceIsSeparate": true,
    "plannedStatusIsNotEvidence": true
  }
}
