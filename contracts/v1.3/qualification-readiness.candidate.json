{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "product": "GLAZE UI V1.3 — Adaptive Resonance",
  "targetProduct": "GLAZE UI V1.3",
  "targetVersion": "1.3.0-candidate",
  "sourceStable": "1.2.0",
  "releaseLifecycle": "proposed",
  "qualificationLifecycle": "qualification-active",
  "lifecycleAuthority": false,
  "consumerEligible": false,
  "principle": "Fresh qualification may satisfy a lifecycle gate; it may not perform lifecycle promotion.",
  "authorities": {
    "deferredPlan": "contracts/v1.3/deferred-qualification.plan.json",
    "deferredAcceptance": "acceptance/v1.3-deferred-qualification.md",
    "matrix": "contracts/v1.3/qualification-matrix.json",
    "evidenceSchema": "contracts/v1.3/qualification-evidence.schema.json",
    "evidenceDirectory": "evidence/v1.3",
    "adaptivePlan": "contracts/v1.3/adaptive-resonance.plan.json"
  },
  "requiredWorkstreams": [
    {
      "id": "human-optical-and-icon-collision-qualification",
      "acceptedReviewModes": ["human", "combined"],
      "freshHumanEvidenceRequired": true
    },
    {
      "id": "manual-assistive-technology-qualification",
      "acceptedReviewModes": ["human", "combined"],
      "freshHumanEvidenceRequired": true
    },
    {
      "id": "physical-device-native-platform-qualification",
      "acceptedReviewModes": ["combined"],
      "freshPhysicalEvidenceRequired": true
    },
    {
      "id": "physical-device-production-performance-qualification",
      "acceptedReviewModes": ["combined"],
      "freshPhysicalEvidenceRequired": true
    },
    {
      "id": "native-personalization-adapter-qualification",
      "acceptedReviewModes": ["human", "combined"],
      "freshNativeEvidenceRequiredWhereClaimed": true
    },
    {
      "id": "stable-activation-and-source-namespace-cleanup",
      "acceptedReviewModes": ["combined"],
      "freshEquivalenceEvidenceRequired": true
    }
  ],
  "recordAcceptance": {
    "requiredStatus": "passed",
    "acceptedForLifecycleGateMustBe": true,
    "exactSourceRevisionRequired": true,
    "singleSharedExactRevisionRequired": true,
    "targetProductMustBe": "GLAZE UI V1.3",
    "targetVersionMustBe": "1.3.0-candidate",
    "expiredEvidenceAllowed": false,
    "unresolvedIssuesAllowed": false,
    "missingWorkstreamAllowed": false,
    "v1_2EvidenceMayBeRelabeled": false
  },
  "outcomes": {
    "blocked": "One or more blocking qualification workstreams lacks current accepted exact-revision evidence.",
    "readyForGovernedCandidatePromotionReview": "All six blocking workstreams have accepted current evidence for one exact revision; formal lifecycle promotion is still required."
  },
  "permissions": {
    "mayActivateCandidate": false,
    "mayChangeVersionFile": false,
    "mayChangeLifecycleRegistry": false,
    "mayCreateConsumerEligibility": false,
    "mayGrantConsumerConformance": false,
    "mayTreatAutomatedCIAsHumanOrPhysicalEvidence": false
  },
  "currentAutomatedBoundary": {
    "repositoryAutomationMayValidateMechanism": true,
    "repositoryAutomationMayValidateEvidenceShape": true,
    "repositoryAutomationMayAggregateReadiness": true,
    "repositoryAutomationMayManufactureHumanEvidence": false,
    "repositoryAutomationMayManufacturePhysicalDeviceEvidence": false,
    "repositoryAutomationMayPromoteLifecycle": false
  }
}
