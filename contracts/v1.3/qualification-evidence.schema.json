{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/glaze-v1.3-qualification-evidence.schema.json",
  "title": "GLAZE UI V1.3 Qualification Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workstream_id",
    "target",
    "status",
    "observed_at",
    "review_authority",
    "evidence_references",
    "disposition"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "workstream_id": {
      "enum": [
        "human-optical-and-icon-collision-qualification",
        "manual-assistive-technology-qualification",
        "physical-device-native-platform-qualification",
        "physical-device-production-performance-qualification",
        "native-personalization-adapter-qualification",
        "stable-activation-and-source-namespace-cleanup"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "target_version", "source_revision"],
      "properties": {
        "product": {"const": "GLAZE UI V1.3"},
        "target_version": {"const": "1.3.0-candidate"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "status": {"enum": ["in_progress", "passed", "failed", "superseded"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "review_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "authority"],
      "properties": {
        "mode": {"enum": ["human", "automated", "combined"]},
        "authority": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "environment": {"type": "object", "additionalProperties": true},
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "quality_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "reviewed_rule_ids",
        "visual_finish_accepted",
        "blandness_rejected",
        "accessibility_beauty_reviewed",
        "responsive_beauty_reviewed",
        "critical_final_quality_questions_accepted"
      ],
      "properties": {
        "contract": {"const": "contracts/v1.3/quality-rules.candidate.json"},
        "reviewed_rule_ids": {
          "type": "array",
          "minItems": 55,
          "maxItems": 55,
          "uniqueItems": true,
          "items": {
            "enum": [
              "quality-01","quality-02","quality-03","quality-04","quality-05",
              "quality-06","quality-07","quality-08","quality-09","quality-10",
              "quality-11","quality-12","quality-13","quality-14","quality-15",
              "quality-16","quality-17","quality-18","quality-19","quality-20",
              "quality-21","quality-22","quality-23","quality-24","quality-25",
              "quality-26","quality-27","quality-28","quality-29","quality-30",
              "quality-31","quality-32","quality-33","quality-34","quality-35",
              "quality-36","quality-37","quality-38","quality-39","quality-40",
              "quality-41","quality-42","quality-43","quality-44","quality-45",
              "quality-46","quality-47","quality-48","quality-49","quality-50",
              "quality-51","quality-52","quality-53","quality-54","quality-55"
            ]
          }
        },
        "visual_finish_accepted": {"type": "boolean"},
        "blandness_rejected": {"type": "boolean"},
        "accessibility_beauty_reviewed": {"type": "boolean"},
        "responsive_beauty_reviewed": {"type": "boolean"},
        "critical_final_quality_questions_accepted": {"type": "boolean"},
        "notes": {"type": "string", "maxLength": 4000}
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "severity", "resolved"],
        "properties": {
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "resolved": {"type": "boolean"},
          "reference": {"type": ["string", "null"], "maxLength": 1000}
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_for_lifecycle_gate", "notes"],
      "properties": {
        "accepted_for_lifecycle_gate": {"type": "boolean"},
        "notes": {"type": "string", "maxLength": 4000}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "disposition": {
            "properties": {"accepted_for_lifecycle_gate": {"const": true}},
            "required": ["accepted_for_lifecycle_gate"]
          },
          "evidence_references": {"minItems": 2}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["in_progress", "failed", "superseded"]}}, "required": ["status"]},
      "then": {
        "properties": {
          "disposition": {
            "properties": {"accepted_for_lifecycle_gate": {"const": false}},
            "required": ["accepted_for_lifecycle_gate"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workstream_id": {"const": "human-optical-and-icon-collision-qualification"},
          "status": {"const": "passed"}
        },
        "required": ["workstream_id", "status"]
      },
      "then": {
        "required": ["quality_review"],
        "properties": {
          "quality_review": {
            "properties": {
              "visual_finish_accepted": {"const": true},
              "blandness_rejected": {"const": true},
              "accessibility_beauty_reviewed": {"const": true},
              "responsive_beauty_reviewed": {"const": true},
              "critical_final_quality_questions_accepted": {"const": true}
            }
          }
        }
      }
    }
  ]
}
