{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "product": "GLAZE UI V1.4.1 — Human Review Harness",
  "version": "1.4.1-candidate",
  "stableBaseline": "1.4.0",
  "harness": "reference/v1.4.1/optical-human-review.html",
  "candidateRuntime": "js/glaze-v1.4.1.candidate.mjs",
  "stableCss": "css/glaze-v1.4.0.css",
  "reviewIssue": 196,
  "authority": "human-review-surface-only",
  "networkPolicy": "repository-local-only",
  "simulatedFormFactorsArePhysicalEvidence": false,
  "automaticHumanAcceptance": false,
  "automaticPromotionEligibility": false,
  "requiredScenarios": [
    "background-simple-dark",
    "background-moderate-mid",
    "background-complex-bright",
    "appearance-light",
    "appearance-dark",
    "appearance-deep-dark",
    "daypart-dawn",
    "daypart-day",
    "daypart-dusk",
    "daypart-night",
    "depth-base",
    "depth-raised",
    "depth-overlay",
    "depth-modal",
    "memory-tint-off",
    "memory-tint-bounded",
    "reduced-transparency",
    "increased-contrast",
    "forced-colors",
    "reduced-motion",
    "adapter-failure-solid-accessible"
  ],
  "reviewChecks": [
    "optical.content-aware-frost",
    "optical.semantic-blur-protection",
    "optical.environment-tint",
    "optical.chromatic-depth",
    "optical.environmental-color-memory",
    "accessibility.reduced-transparency",
    "accessibility.increased-contrast",
    "accessibility.forced-colors",
    "accessibility.reduced-motion",
    "input.keyboard",
    "input.pointer",
    "polish.glass-quality",
    "polish.depth-warmth",
    "polish.visual-balance",
    "identity.goreecloud-recognition"
  ],
  "formFactorSimulations": ["desktop", "mobile", "tablet", "tv", "watch", "foldable"],
  "rules": {
    "exactRevisionMustBeVisible": true,
    "reviewSurfaceMustDisplayNonEvidenceNotice": true,
    "reviewSurfaceMustDisplaySimulationBoundary": true,
    "noRemoteAssets": true,
    "noTelemetry": true,
    "noCamera": true,
    "noAutomaticPassControls": true,
    "noAutomaticEvidenceRecordGeneration": true,
    "adapterFailureScenarioRequired": true,
    "stableV140MachineAuthorityMustRemainValid": true,
    "humanEvidenceProtocolMustRemainValid": true
  }
}
