{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "id": "goreecloud.glaze-ui.v1.2.states-feedback-recovery.candidate",
  "product": "GLAZE UI V1.2",
  "version": "1.2.0-candidate",
  "lifecycle": "candidate",
  "consumerEligible": false,
  "stableBaseline": "1.1.0",
  "status": "bounded-states-feedback-recovery-reference",
  "purpose": "Provide bounded truthful state, feedback, and recovery presentation over existing semantic/state authorities without creating producer truth or adopting proposed state components.",
  "authority": {
    "companionSpecification": "Glaze UI V1.2 — States, Feedback, and Recovery.docx",
    "interactionStates": "contracts/v1.2/interaction-states.candidate.json",
    "semanticColors": "tokens/semantic-colors.json",
    "formFactor": "contracts/v1.2/form-factor-tokens.candidate.json",
    "principle": "State should tell the truth immediately, feedback should explain what changed, and recovery should always clarify what the user can do next."
  },
  "canonicalComponentBoundary": {
    "catalog": "contracts/components/v1/catalog.json",
    "catalogExtensionIntroduced": false,
    "proposedExtensionsRemainNonCanonical": [
      "GlzStatus",
      "GlzStatusBadge",
      "GlzProgress",
      "GlzActivityIndicator",
      "GlzSkeleton",
      "GlzBanner",
      "GlzEmptyState",
      "GlzErrorState",
      "GlzRecoveryState",
      "GlzActivityCenter",
      "GlzSyncState",
      "GlzFreshnessIndicator"
    ]
  },
  "referenceScenes": [
    "loading",
    "determinate-progress",
    "indeterminate-progress",
    "success",
    "warning",
    "critical-failure",
    "offline",
    "reconnecting",
    "syncing",
    "partial-success",
    "degraded",
    "stale",
    "unknown",
    "empty",
    "no-results",
    "recovery",
    "recovery-failure",
    "mobile-feedback",
    "deep-dark",
    "reduced-transparency",
    "increased-contrast"
  ],
  "rules": {
    "truthBeforeDecoration": true,
    "unknownIsFirstClass": true,
    "missingEvidenceCannotUpgradeToPositive": true,
    "successRequiresExplicitCompletionOrAuthoritativePositiveState": true,
    "warningAndCriticalFailureRemainDistinct": true,
    "onlineDoesNotImplyHealthySyncedSecureOrProtected": true,
    "offlineDoesNotImplyFailureDataLossUnhealthyOrUnprotected": true,
    "pendingQueuedLoadingSyncingPausedFailedAndSuccessRemainDistinct": true,
    "determinateProgressMustReflectAuthoritativeProgress": true,
    "indeterminateProgressCannotFabricatePercentage": true,
    "partialSuccessMustExposeSucceededFailedAndRemainingScope": true,
    "staleDataMustNotLookCurrent": true,
    "missingDataMustNotBecomeZero": true,
    "emptyNoResultsAndLoadFailureRemainDistinct": true,
    "localFailureShouldRemainLocalWherePossible": true,
    "retryOnlyWhenRepeatingMayHelp": true,
    "recoveryCannotDeclareCompleteBeforeAuthoritativeConfirmation": true,
    "recoveryVerificationRemainsVisibleWhenCompletionDependsOnVerification": true,
    "syncConflictMustNotSilentlyChooseASide": true,
    "pendingOfflineChangesMustNotAppearRemotelyCommitted": true,
    "criticalFailureMustNotDependOnTransientToastOnly": true,
    "feedbackPersistenceMatchesImportance": true,
    "importantStateHasNonColorCompanion": true,
    "noRuntimeNetworkRequest": true,
    "noRuntimePersistence": true,
    "noRuntimeProducerTruthComputation": true,
    "noNewCanonicalComponent": true,
    "noNewMaterialCalibration": true
  },
  "transitionAcceptance": [
    "loading-to-content",
    "pending-to-processing",
    "processing-to-success",
    "processing-to-failure",
    "online-to-offline",
    "offline-to-connecting-to-syncing-to-current",
    "current-to-stale",
    "error-to-retry-to-recovery"
  ],
  "modeCoverage": ["compact", "deep-dark", "text-scale-200", "reduced-motion", "reduced-transparency", "increased-contrast", "forced-colors", "rtl"],
  "dataAuthorityBoundary": {
    "referenceStateIsFixtureOnly": true,
    "runtimeFetchesAuthoritativeState": false,
    "runtimePersistsState": false,
    "runtimeInfersSecurityPrivacyIdentityHealthSyncOrRecoveryTruth": false,
    "producerAcknowledgementEventRequiredForFixtureRecoveryCompletion": true,
    "producerAcknowledgementEventIsReferenceSimulationOnly": true
  },
  "implementation": {
    "webLayer": "css/glaze-v1.2-states-feedback-recovery.candidate.css",
    "runtime": "js/glaze-v1.2-states-feedback-recovery.candidate.mjs",
    "reference": "reference/v1.2/states-feedback-recovery.html",
    "renderedValidator": "scripts/validate_glaze_v1_2_states_feedback_recovery_rendered.py",
    "workflow": ".github/workflows/glaze-v1.2-states-feedback-recovery.yml",
    "candidateEntrypoint": "css/glaze-v1.2.0-candidate.css"
  },
  "evidenceBoundary": {
    "implemented": [
      "bounded-reference-state-scenes",
      "truthful-fixture-state-distinction",
      "non-color-state-cues",
      "fixture-transition-demonstration",
      "producer-acknowledgement-gated-fixture-recovery-completion",
      "compact-deep-dark-large-text-reduced-motion-reduced-transparency-increased-contrast-forced-colors-rtl-rendered-gates"
    ],
    "notEstablished": [
      "canonical-adoption-of-proposed-state-components",
      "real-producer-state-integration",
      "real-retry-or-recovery-orchestration",
      "real-sync-conflict-resolution",
      "real-backup-or-restore-verification",
      "native-state-feedback-parity",
      "assistive-technology-human-acceptance",
      "production-resilience-acceptance",
      "release-candidate",
      "stable",
      "consumer-conformance"
    ]
  }
}
