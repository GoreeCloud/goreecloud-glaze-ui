{
  "schemaVersion": 1,
  "id": "glaze-v1.2-exact-head-readiness-candidate",
  "product": "GLAZE UI",
  "version": "1.2.0-candidate",
  "lifecycle": "candidate",
  "stableBaseline": "1.1.0",
  "consumerEligible": false,
  "phase": "Phase 5 — Exact-Head Readiness Evidence",
