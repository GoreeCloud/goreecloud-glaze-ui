{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "id": "goreecloud.glaze-ui.v1.2.productive-interfaces.candidate",
  "product": "GLAZE UI V1.2",
  "version": "1.2.0-candidate",
  "lifecycle": "candidate",
  "consumerEligible": false,
  "stableBaseline": "1.1.0",
  "status": "bounded-productive-interface-behavior",
  "purpose": "Extend the canonical GlzTable and existing Structure/Foundation controls into bounded productive workflows without promoting proposed productive-interface components or manufacturing producer-authoritative data state.",
  "authority": {
    "companionSpecification": "Glaze UI V1.2 — Tables and Productive Interfaces.docx",
    "structureComponents": "contracts/v1.2/structure-components.candidate.json",
    "forms": "contracts/v1.2/forms-data-entry.candidate.json",
    "interactionStates": "contracts/v1.2/interaction-states.candidate.json",
    "formFactor": "contracts/v1.2/form-factor-tokens.candidate.json",
    "principle": "Productivity density should increase information, not friction."
  },
  "canonicalComponentBoundary": {
    "catalog": "contracts/components/v1/catalog.json",
    "catalogExtensionIntroduced": false,
    "canonicalPrimaryComponent": "GlzTable",
    "canonicalSupportingComponents": ["GlzButton", "GlzIconButton", "GlzTextField", "GlzSelect", "GlzCheckbox", "GlzList", "GlzToolbar", "GlzMenu", "GlzSheet"],
    "proposedExtensionsRemainNonCanonical": ["GlzDataGrid", "GlzCommandBar", "GlzFilterBar", "GlzFilterChip", "GlzInspector", "GlzStatusCell", "GlzProgressCell", "GlzColumnPicker", "GlzBulkActionBar", "GlzLogViewer", "GlzRecordList", "GlzSavedView"]
  },
  "rules": {
    "productiveDensityIsNotMiniaturization": true,
    "denseTablesUseStableSurfaces": true,
    "tableLayerIntroducesBackdropBlur": false,
    "selectedFocusedAndActiveStatesMustRemainDistinct": true,
    "essentialActionsCannotRequireHover": true,
    "multiSelectionCountMustBeVisible": true,
    "bulkActionScopeMustBeExplicit": true,
    "destructiveBulkActionMustNotResembleRoutineFilter": true,
    "sortColumnAndDirectionMustRemainVisible": true,
    "activeFiltersMustRemainVisible": true,
    "clearFiltersMustNotResetUnrelatedSortOrDensity": true,
    "searchScopeMustRemainVisible": true,
    "wideTableMayScrollHorizontallyButPageMayNot": true,
    "fullTruncatedValueMustRemainAccessible": true,
    "inspectorMustCorrespondToSelectedRecord": true,
    "multiSelectionInspectorMustNotPretendToRepresentOneObject": true,
    "inlineCommitRequiresProducerAcknowledgement": true,
    "unknownStateMustBeDistinctFromHealthyOfflineUnavailableAndError": true,
    "indeterminateProgressCannotFabricatePercentage": true,
    "staleDataMustBeVisibleWhenMaterial": true,
    "partialFailureRetainsUsableDataWhereSafe": true,
    "liveLogAutoScrollPausesWhenUserLeavesLiveEdge": true,
    "emptyNoResultsUnavailableAndRestrictedStatesMustRemainDistinct": true,
    "keyboardCoreOperationRequired": true,
    "touchTargetsRemainAccessibleInProductiveDensity": true,
    "noRuntimeNetworkRequest": true,
    "noRuntimePersistence": true,
    "noNewCanonicalComponent": true,
    "noNewMaterialCalibration": true
  },
  "referenceScenes": [
    "file-browser",
    "device-manager",
    "service-manager",
    "metrics-table",
    "log-viewer",
    "network-records",
    "identity-administration",
    "bulk-selection",
    "advanced-filtering",
    "table-inspector"
  ],
  "modeCoverage": ["mobile-structured-list", "deep-dark", "text-scale-200", "reduced-transparency", "forced-colors", "rtl"],
  "interactiveAcceptance": {
    "minimumInteractiveTargetPx": 48,
    "assistedTargetPx": 56,
    "sorting": ["visible-sortability", "aria-sort", "direction-change", "actual-reference-row-reorder"],
    "filtering": ["visible-active-filter", "visible-count", "clear-filter", "search-scope", "no-results-keeps-query-context"],
    "selection": ["checkbox-selection", "selection-count", "bulk-bar", "single-record-inspector", "multi-selection-inspector"],
    "states": ["status-icon-and-label", "unknown-explicit", "stale-explicit", "partial-failure-explicit", "indeterminate-progress-without-percent"],
    "overflow": ["table-local-horizontal-scroll", "page-horizontal-overflow-prohibited"],
    "adaptation": ["expanded-table", "compact-structured-list", "200-percent-text", "rtl"]
  },
  "dataAuthorityBoundary": {
    "referenceDataIsFixtureOnly": true,
    "runtimeFetchesAuthoritativeData": false,
    "runtimePersistsViewCustomization": false,
    "runtimeClaimsProducerUpdateSuccess": false,
    "statusLabelsAreExplicitFixtureValues": true
  },
  "implementation": {
    "webLayer": "css/glaze-v1.2-productive-interfaces.candidate.css",
    "runtime": "js/glaze-v1.2-productive-interfaces.candidate.mjs",
    "reference": "reference/v1.2/productive-interfaces.html",
    "renderedValidator": "scripts/validate_glaze_v1_2_productive_interfaces_rendered.py",
    "workflow": ".github/workflows/glaze-v1.2-productive-interfaces.yml",
    "candidateEntrypoint": "css/glaze-v1.2.0-candidate.css"
  },
  "evidenceBoundary": {
    "implemented": [
      "bounded-ten-scene-web-productive-reference",
      "canonical-glztable-composition",
      "visible-sorting-filtering-selection-and-scope",
      "single-and-multi-selection-inspector-state",
      "explicit-unknown-stale-partial-failure-and-indeterminate-operation-state",
      "local-wide-table-overflow",
      "compact-structured-list-transformation",
      "productive-density-with-target-floor-preservation",
      "deep-dark-rtl-200-percent-text-reduced-transparency-forced-colors-rendered-gates",
      "exact-head-rendered-acceptance"
    ],
    "notEstablished": [
      "canonical-adoption-of-proposed-productive-components",
      "server-pagination",
      "virtualization",
      "real-column-resize-or-persistence",
      "real-column-reorder-or-persistence",
      "real-inline-edit-persistence",
      "real-live-log-stream",
      "real-authoritative-refresh",
      "native-productive-interface-parity",
      "assistive-technology-human-acceptance",
      "production-performance-with-large-datasets",
      "release-candidate",
      "stable",
      "consumer-conformance"
    ]
  }
}
