{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "id": "goreecloud.glaze-ui.v1.2.responsive-adaptation-reference.candidate",
  "product": "GLAZE UI V1.2",
  "version": "1.2.0-candidate",
  "lifecycle": "candidate",
  "consumerEligible": false,
  "stableBaseline": "1.1.0",
  "status": "bounded-responsive-form-factor-reference",
  "purpose": "Validate capability-driven recomposition and cross-form-factor continuity without redefining the V1.2 form-factor token owner or claiming platform/device acceptance.",
  "authority": {
    "companionSpecification": "Glaze UI V1.2 — Responsive and Form-Factor Adaptation.docx",
    "formFactorTokens": "contracts/v1.2/form-factor-tokens.candidate.json",
    "spatialFoundation": "contracts/v1.2/spatial-foundation.candidate.json",
    "systemShell": "contracts/v1.2/system-shell-navigation.candidate.json",
    "principle": "Adapt the experience, not merely the dimensions."
  },
  "authorityBoundary": {
    "introducesNewFormFactorTokenOwner": false,
    "introducesDeviceBrandBreakpoints": false,
    "runtimeInfersDeviceIdentity": false,
    "runtimeSelectsProductionCapabilityClass": false,
    "platformAdapterRemainsCapabilitySelectionAuthority": true,
    "referenceRecompositionIsFixtureOnly": true
  },
  "referenceScenes": [
    "320-mobile",
    "modern-mobile-portrait",
    "mobile-landscape",
    "tablet-portrait",
    "tablet-landscape",
    "narrow-desktop",
    "standard-desktop",
    "ultra-wide-desktop",
    "folded-foldable",
    "unfolded-foldable",
    "tv-far-view",
    "wearable",
    "reduced-transparency",
    "text-scale-200",
    "rtl"
  ],
  "layoutClassMapping": {
    "320-mobile": "compact",
    "modern-mobile-portrait": "compact",
    "mobile-landscape": "medium",
    "tablet-portrait": "medium",
    "tablet-landscape": "medium",
    "narrow-desktop": "compact",
    "standard-desktop": "expanded",
    "ultra-wide-desktop": "expanded",
    "folded-foldable": "compact",
    "unfolded-foldable": "medium",
    "tv-far-view": "large",
    "wearable": "wearable",
    "reduced-transparency": "expanded",
    "text-scale-200": "compact",
    "rtl": "expanded"
  },
  "semanticCompositionStateForFarView": "largeFarView",
  "rules": {
    "widthIsNotDeviceIdentity": true,
    "capabilityInputsExtendBeyondWidth": true,
    "mobileIsFirstClass": true,
    "desktopSqueezedIntoMobileProhibited": true,
    "semanticTaskPreservedAcrossRecomposition": true,
    "currentLocationPreservedAcrossRecomposition": true,
    "importantStatePreservedAcrossRecomposition": true,
    "userEnteredDataPreservedAcrossRecomposition": true,
    "selectionPreservedAcrossRecomposition": true,
    "focusPreservedWherePractical": true,
    "scrollContextPreservedWherePractical": true,
    "recompositionMustNotRequirePageReload": true,
    "safeAreaInsetsAreFunctionalConstraints": true,
    "keyboardOcclusionIsFunctionalConstraint": true,
    "wideTablesDoNotCausePageHorizontalScroll": true,
    "compactTablesMayTransformToStructuredLists": true,
    "foldPostureMayChangeCompositionWithoutChangingTask": true,
    "farViewUsesAtLeast56PxClassTargets": true,
    "wearablePrioritizesGlanceablePrimaryValue": true,
    "touchAndPointerCanCoexistWithoutTouchIncompleteness": true,
    "reducedTransparencyPreservesMeaning": true,
    "textScale200PreservesCoreTask": true,
    "rtlUsesLogicalLayout": true,
    "noRuntimeNetworkRequest": true,
    "noRuntimePersistence": true,
    "noNewCanonicalComponent": true,
    "noNewMaterialCalibration": true
  },
  "interactiveAcceptance": {
    "minimumInteractiveTargetPx": 48,
    "farViewMinimumInteractiveTargetPx": 56,
    "narrowWebWidthPx": 320,
    "continuity": ["current-destination", "selection", "typed-value", "focus", "fixture-state"],
    "layoutClasses": ["compact", "medium", "expanded", "large", "wearable"],
    "accessibilityModes": ["reduced-transparency", "text-scale-200", "rtl", "forced-colors"],
    "platformSpecificEvidenceRequiredForProductionClaims": true
  },
  "implementation": {
    "webLayer": "css/glaze-v1.2-responsive-adaptation-reference.candidate.css",
    "runtime": "js/glaze-v1.2-responsive-adaptation-reference.candidate.mjs",
    "reference": "reference/v1.2/responsive-adaptation.html",
    "renderedValidator": "scripts/validate_glaze_v1_2_responsive_adaptation_rendered.py",
    "workflow": ".github/workflows/glaze-v1.2-responsive-adaptation.yml",
    "candidateEntrypoint": "css/glaze-v1.2.0-candidate.css"
  },
  "evidenceBoundary": {
    "implemented": [
      "bounded-15-scenario-web-reference",
      "capability-class-reference-recomposition",
      "task-location-selection-input-focus-continuity",
      "320px-page-overflow-gate",
      "folded-and-unfolded-reference-composition",
      "far-view-56px-reference-target-gate",
      "wearable-glanceable-reference",
      "reduced-transparency-200-percent-text-rtl-reference-gates",
      "exact-head-rendered-acceptance"
    ],
    "notEstablished": [
      "automatic-production-capability-selection",
      "physical-safe-area-device-matrix",
      "software-keyboard-device-acceptance",
      "real-foldable-hinge-posture-runtime-acceptance",
      "real-tv-remote-directional-acceptance",
      "real-wearable-rotary-or-touch-acceptance",
      "spatial-runtime-acceptance",
      "native-form-factor-parity",
      "human-form-factor-acceptance",
      "assistive-technology-human-acceptance",
      "production-performance-acceptance",
      "release-candidate",
      "stable",
      "consumer-conformance"
    ]
  }
}
