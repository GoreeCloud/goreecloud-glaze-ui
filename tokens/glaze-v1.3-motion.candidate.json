{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "id": "goreecloud.glaze-ui.v1.3.motion.tokens.candidate",
  "product": "GLAZE UI V1.3 — Adaptive Resonance",
  "targetVersion": "1.3.0-candidate",
  "releaseLifecycle": "proposed",
  "artifactLifecycle": "implementation-candidate-artifact",
  "lifecycleAuthority": false,
  "consumerEligible": false,
  "sourceStable": "1.2.0",
  "namespace": "motion",
  "semanticTokens": {
    "motion.direct": {"implementation": "direct", "meaning": "direct manipulation or immediate state response"},
    "motion.micro": {"implementation": "fast", "meaning": "small local response"},
    "motion.standard": {"implementation": "standard", "meaning": "ordinary state transition"},
    "motion.connected": {"implementation": "spatial", "meaning": "context-preserving connected transformation"},
    "motion.expressive": {"implementation": "expressive", "meaning": "bounded high-value expressive transition"},
    "motion.reduced": {"implementation": "reduced", "meaning": "reduced-motion semantic equivalent"},
    "motion.minimal": {"implementation": "minimal", "meaning": "nonessential travel removed"}
  },
  "implementationValues": {
    "direct": {"source": "tokens/glaze-v1.2-motion.candidate.json", "pointer": "/easing/direct", "mode": "inherited-baseline"},
    "fast": {"source": "tokens/glaze-v1.2-motion.candidate.json", "pointer": "/durationsMs/fast", "mode": "inherited-baseline"},
    "standard": {"source": "tokens/glaze-v1.2-motion.candidate.json", "pointer": "/durationsMs/standard", "mode": "inherited-baseline"},
    "spatial": {"source": "tokens/glaze-v1.2-motion.candidate.json", "pointer": "/durationsMs/spatial", "mode": "inherited-baseline"},
    "reduced": {"source": "tokens/glaze-v1.2-motion.candidate.json", "pointer": "/profiles/reduced", "mode": "inherited-baseline"},
    "minimal": {"source": "tokens/glaze-v1.2-motion.candidate.json", "pointer": "/profiles/minimal", "mode": "inherited-baseline"},
    "expressive": {"status": "architecture-established-runtime-unestablished", "ownerWorkstream": "motion-and-continuity"},
    "springSemantics": {"status": "architecture-established-runtime-unestablished", "ownerWorkstream": "motion-and-continuity"}
  },
  "rules": {
    "motionMustPreserveContext": true,
    "animationForAnimationSakeAllowed": false,
    "continuousRestlessAnimationAllowed": false,
    "reducedMotionPreservesSemanticStateChange": true,
    "reducedMotionMayCollapseTravel": true,
    "directManipulationTrackingRemainsImmediate": true,
    "motionMayMisrepresentActualProgress": false,
    "semanticTokensMayContainRawDurationsOrCurves": false
  },
  "notEstablished": [
    "v1.3-spring-calibration",
    "connected-transformation-matrix",
    "expression-profile-motion-deltas",
    "interaction-velocity-motion-response"
  ]
}
