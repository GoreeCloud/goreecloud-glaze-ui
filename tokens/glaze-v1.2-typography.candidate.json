{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "id": "goreecloud.glaze-ui.v1.2.typography.tokens.candidate",
  "version": "1.2.0-candidate",
  "lifecycle": "candidate",
  "consumerEligible": false,
  "stableBaseline": "1.1.0",
  "family": {
    "sans": "system-ui, ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "monospace": "ui-monospace, SFMono-Regular, Consolas, Liberation Mono, Menlo, monospace",
    "sourcePolicy": "system-platform-native-first; locally bundled approved fonts may substitute; third-party runtime font delivery is prohibited"
  },
  "weights": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "strong": 700
  },
  "roles": {
    "display": {"size": "clamp(2.5rem, 5vw, 4rem)", "lineHeight": 1.04, "weight": 600, "letterSpacing": "-0.03em"},
    "largeTitle": {"size": "clamp(2rem, 4vw, 3rem)", "lineHeight": 1.08, "weight": 600, "letterSpacing": "-0.025em"},
    "title": {"size": "1.75rem", "lineHeight": 1.14, "weight": 600, "letterSpacing": "-0.02em"},
    "heading": {"size": "1.375rem", "lineHeight": 1.2, "weight": 600, "letterSpacing": "-0.01em"},
    "subheading": {"size": "1.125rem", "lineHeight": 1.3, "weight": 600, "letterSpacing": "-0.005em"},
    "body": {"size": "1rem", "lineHeight": 1.55, "weight": 400, "letterSpacing": "0"},
    "ui": {"size": "0.9375rem", "lineHeight": 1.2, "weight": 500, "letterSpacing": "-0.005em"},
    "label": {"size": "0.8125rem", "lineHeight": 1.25, "weight": 500, "letterSpacing": "0.01em"},
    "caption": {"size": "0.75rem", "lineHeight": 1.35, "weight": 400, "letterSpacing": "0.01em"},
    "numeric": {"size": "2rem", "lineHeight": 1.05, "weight": 600, "letterSpacing": "-0.015em", "fontVariantNumeric": "tabular-nums lining-nums"},
    "monospace": {"size": "0.875rem", "lineHeight": 1.5, "weight": 400, "letterSpacing": "0", "fontVariantLigatures": "none"}
  },
  "composition": {
    "iconLabelGap": "0.5rem",
    "metricUnitScale": 0.5,
    "metricUnitWeight": 500,
    "readingMeasure": "70ch",
    "technicalMeasure": "82ch"
  },
  "appearance": {
    "light": {"primary": "#151C22", "secondary": "#7E8D99", "tertiary": "#667783"},
    "dark": {"primary": "#F4F8FA", "secondary": "#B9C5CD", "tertiary": "#8F9DA8"},
    "deepDark": {"primary": "#F4F8FA", "secondary": "#AEBCC6", "tertiary": "#83929D"}
  },
  "rules": {
    "softMaterialSharpText": true,
    "defaultTextUsesAtmosphericBlue": false,
    "normalTextGlowAllowed": false,
    "remoteRuntimeFontDependencyAllowed": false,
    "largeTextReflowMinimumPercent": 200,
    "rtlLogicalAlignmentRequired": true
  }
}
