{
  "schemaVersion": 1,
  "id": "glaze-v1.2-frosted-neutral-candidate",
  "product": "GLAZE UI V1.2",
  "version": "1.2.0-candidate",
  "lifecycle": "candidate",
  "stableBaseline": "1.1.1",
  "visualBaseline": "1.1.0",
  "currentStableToken": false,
  "governingRule": "Neutral glass is the material. Color is an accent.",
  "materials": {
    "light": {
      "baseGlass": "rgba(255, 255, 255, 0.58)",
      "raisedGlass": "rgba(255, 255, 255, 0.72)",
      "overlayGlass": "rgba(250, 250, 250, 0.82)",
      "panelGlass": "rgba(255, 255, 255, 0.76)",
      "specularBorder": "rgba(255, 255, 255, 0.52)",
      "structuralBorder": "rgba(80, 80, 80, 0.10)",
      "shadowSoft": "0 14px 38px rgba(0, 0, 0, 0.11)",
      "shadowFloat": "0 28px 76px rgba(0, 0, 0, 0.16)"
    },
    "dark": {
      "baseGlass": "rgba(25, 25, 27, 0.62)",
      "raisedGlass": "rgba(38, 38, 41, 0.72)",
      "overlayGlass": "rgba(42, 42, 45, 0.82)",
      "panelGlass": "rgba(34, 34, 37, 0.76)",
      "specularBorder": "rgba(255, 255, 255, 0.12)",
      "structuralBorder": "rgba(255, 255, 255, 0.10)",
      "shadowSoft": "0 18px 48px rgba(0, 0, 0, 0.30)",
      "shadowFloat": "0 30px 86px rgba(0, 0, 0, 0.44)"
    },
    "deepDark": {
      "baseGlass": "rgba(14, 14, 16, 0.72)",
      "raisedGlass": "rgba(22, 22, 25, 0.78)",
      "overlayGlass": "rgba(24, 24, 27, 0.86)",
      "panelGlass": "rgba(18, 18, 21, 0.82)",
      "specularBorder": "rgba(255, 255, 255, 0.11)",
      "structuralBorder": "rgba(255, 255, 255, 0.09)",
      "shadowSoft": "0 20px 54px rgba(0, 0, 0, 0.38)",
      "shadowFloat": "0 34px 96px rgba(0, 0, 0, 0.52)"
    }
  },
  "effects": {
    "blur": {
      "soft": "24px",
      "standard": "28px",
      "heavy": "44px"
    },
    "backdropSaturation": {
      "soft": 1.08,
      "standard": 1.10,
      "live": 1.15
    },
    "edgeLightDirection": "upper-left",
    "innerSpecular": true,
    "hardOutlineDefault": false
  },
  "chromaticMaterialPolicy": {
    "defaultChromaticMaterialTint": 0,
    "tealAsBaseMaterialAllowed": false,
    "greenAsBaseMaterialAllowed": false,
    "aquaAsBaseMaterialAllowed": false,
    "amberAsBaseMaterialAllowed": false,
    "brandColorMayDefineSubstrate": false,
    "semanticColorMayDefineSubstrate": false,
    "accentColorUse": [
      "active-control",
      "focus",
      "selection",
      "progress",
      "semantic-status",
      "icon",
      "product-identity"
    ]
  },
  "atmosphere": {
    "defaultMaterialTintContribution": 0,
    "environmentalAuraOptional": true,
    "environmentalAuraMayPassThroughBackdrop": true,
    "environmentalAuraMustRemainOutsideSubstrate": true,
    "lightAuraMaxAlpha": {
      "teal": 0.025,
      "amber": 0.012
    },
    "darkAuraMaxAlpha": {
      "teal": 0.04,
      "amber": 0.02
    },
    "deepDarkAuraMaxAlpha": {
      "teal": 0.05,
      "amber": 0.025
    }
  },
  "materialHierarchy": [
    "canvas",
    "surface",
    "soft-glaze",
    "glaze",
    "deep-glaze",
    "live-glaze"
  ],
  "hierarchyRules": {
    "depthBeforeHue": true,
    "depthSignals": [
      "blur",
      "opacity",
      "luminance",
      "border-reflection",
      "geometry",
      "shadow"
    ],
    "nestedBackdropBlurDefaultAllowed": false,
    "dominantGlazeRegionsMax": 1,
    "smallFloatingGlazeControlsMax": 3
  },
  "accessibility": {
    "reducedTransparency": {
      "backdropBlur": "off",
      "fallback": "solid-neutral",
      "preserveHierarchy": true,
      "preserveContrast": true,
      "preserveSemanticState": true
    },
    "forcedColors": {
      "customMaterialPigmentation": "off",
      "customSpecularEdges": "off",
      "colorMapping": "platform"
    },
    "increasedContrast": {
      "strengthenBoundariesBeforeChroma": true
    },
    "reducedMotion": {
      "independentFromTransparency": true
    }
  },
  "performanceDegradationOrder": [
    "stop-optional-atmospheric-movement",
    "remove-environmental-aura",
    "reduce-heavy-blur-to-standard",
    "reduce-standard-blur-to-soft",
    "fall-back-to-solid-neutral-surfaces"
  ],
  "protectedFromDegradation": [
    "content",
    "actions",
    "focus",
    "semantic-state",
    "hierarchy",
    "target-size"
  ]
}
