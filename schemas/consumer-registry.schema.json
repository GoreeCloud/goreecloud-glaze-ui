{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/schemas/glaze-ui/consumer-registry.schema.json",
  "title": "Glaze UI V1.2 Consumer Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "officialBaseline",
    "officialProductLabel",
    "requiredConsumerVersion",
    "auditedAt",
    "statusVocabulary",
    "enforcement",
    "consumers"
  ],
  "properties": {
    "schemaVersion": {"const": 6},
    "officialBaseline": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "officialProductLabel": {"type": "string", "minLength": 1},
    "requiredConsumerVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "auditedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "statusVocabulary": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "items": {"enum": ["adoption-required", "unverified", "accepted-v1"]}
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "officialCurrentRequired",
        "productionExceptionsAllowed",
        "platformScope",
        "unsupportedPlatformRule"
      ],
      "properties": {
        "officialCurrentRequired": {"const": true},
        "productionExceptionsAllowed": {"const": false},
        "platformScope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "unsupportedPlatformRule": {"type": "string", "minLength": 1}
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "repository",
          "status",
          "targetVersion",
          "requiredTargetVersion",
          "referenceRevision",
          "evidence",
          "productionEligible",
          "notes"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "pattern": "^GoreeCloud/.+$"},
          "status": {"enum": ["adoption-required", "unverified", "accepted-v1"]},
          "targetVersion": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
            ]
          },
          "requiredTargetVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
          "referenceRevision": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            ]
          },
          "evidence": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "minLength": 1}
            ]
          },
          "productionEligible": {"const": false},
          "notes": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"enum": ["adoption-required", "unverified"]}}, "required": ["status"]},
            "then": {
              "properties": {
                "targetVersion": {"type": "null"},
                "referenceRevision": {"type": "null"},
                "evidence": {"type": "null"}
              }
            }
          },
          {
            "if": {"properties": {"status": {"const": "accepted-v1"}}, "required": ["status"]},
            "then": {
              "properties": {
                "targetVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
                "referenceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "evidence": {"type": "string", "minLength": 1}
              }
            }
          }
        ]
      }
    }
  }
}
